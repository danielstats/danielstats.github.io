delete_x_games <- function(x, start = 1){
  for(i in start:x){
    eval(parse(text = paste0("rm(game",i, ", envir = globalenv())")))
  }
}

create_garbage <- function(players = c("player1", "player2"), 
                           wilds = c("KC", "KD", "KH", "KS")){
  gamestate <- list(deck = sample(mosaicData::Cards),
                 discard = NULL, 
                 active_card = NA, 
                 wilds = wilds,
                 players = players)
  structure(c(gamestate, 
              mapply(function(x) x = NULL, players),
              mapply(function(x) x = NULL, paste0(players, "_face_up"))), 
            class = "garbage_game")

}

deal_garbage_hand <- function(game, hand_sizes = c(10,10)){
  player_names <- game$players
  stopifnot(class(game) == "garbage_game")
  num_players <- length(player_names)
  #the first set of cards to deal is the smallest hand
  hand_size_diff <- min(hand_sizes)
  hand_size_min <- hand_size_diff #the smallest hand
  
  for (j in 1:length(game$players)) {
    #set first min hand size
    for (i in 1:num_players) {
      player <- player_names[i]
      eval(parse(text = paste0("game$", player, "<- c(game$", player, 
                               ", game[[1]][seq(", i,",num_players * hand_size_diff, num_players)])")))
      eval(parse(text = paste0("game$", player, 
                               "_face_up <- c(game$",player,"_face_up, rep(FALSE, hand_size_diff))")))
    }
    #remove cards from deck
    game[[1]] <- game[[1]][-c(1:(hand_size_diff*num_players))]
    if (j == length(game$players)) {break}
    #get rid of player with smallest hand and adjust hand diff
    hand_size_min <- min(hand_sizes)
    new_hand_sizes <- hand_sizes[hand_sizes != min(hand_sizes)]
    if (length(new_hand_sizes) == 0) {break}
    hand_size_diff <- min(new_hand_sizes) - hand_size_min
    # cat("hand_size_diff: ",hand_size_diff, "\nhand_sizes: ", hand_sizes, "\nmin hand size: ", hand_size_min, "\n")
    # cat(player_names)
    player_names <- player_names[hand_sizes != min(hand_sizes)]
    num_players <- length(player_names)
    hand_sizes <- new_hand_sizes
    # cat("players left: ", player_names, "\n this is j ", j)
  }

  game$discard <- game$deck[1]
  game$deck <- game$deck[-1]
  game
}

is_card_face_up <- function(game, player_name, hand_position){
  stopifnot(class(game) == "garbage_game")
  eval(parse(text = paste0("game$", player_name, "_face_up[", hand_position, "]")))
}

set_card_flipness <- function(game, player_name, hand_position, flipness = TRUE){
  stopifnot(class(game) == "garbage_game")
  eval(parse(text = paste0("game$", player_name, "_face_up[", hand_position, "] <- ", flipness)))
  game
}

draw_card <- function(game){
  stopifnot(class(game) == "garbage_game")
  if(!is.na(game$active_card)){stop("cannot draw, already have an active card. Discard first.")}
  if(length(game$deck) == 0) {
    game$deck <- sample(game$discard[-1])
    game$discard <- game$discard[1]
  }
  game$active_card <- game$deck[1]
  game$deck <- game$deck[-1]
  game
}

discard_playable_garbage <- function(game, player_name){
  dis_card <- game$discard[1]
  if(dis_card %in% game$wilds){
    return(TRUE)
  }
  dis_card <- stringr::str_sub(dis_card, end = -2)
  #deal with Aces, Jacks, Queens, and Kings.
  if (dis_card == "A"){dis_card <- 1}
  if (dis_card %in% c("J", "Q", "K")){return(FALSE)}
  #now the numbers
  dis_card <- as.numeric(dis_card)
  #if the card is higher than the hand size, discard it
  hand_size <- length(eval(parse(text = paste0("game$", player_name))))
  if(dis_card > hand_size){
    return(FALSE)
  }
  #if the player has a facedown card in that spot, replace it and then try to play with the replaced card
  if(!is_card_face_up(game, player_name, dis_card)){
    return(TRUE)
  } else{
    #if the card was face up, see if it's a wild or the same number
    face_up_card <- pull_player_card(game, player_name, dis_card)
    if(face_up_card %in% game$wilds){
      return(TRUE) #if it's wild, replace and play the wild
    }
    #check if it's the same number
    face_up_card_num <- stringr::str_sub(face_up_card, end = -2)
    if(face_up_card_num == "A"){face_up_card_num <- 1}
    if(face_up_card_num == dis_card) {
      return(FALSE)
    }
  }
}

take_turn_garbage <- function(game, player_name, wild_strat = "rand"){
  stopifnot(class(game) == "garbage_game")
  # cat(game$discard, "\n")
  if(!is.null(game$discard)){
    if(discard_playable_garbage(game, player_name)){
    game$active_card <- game$discard[1]
    game$discard <- game$discard[-1]
    }
    else{game <- draw_card(game)}
  }
  else{
    game <- draw_card(game)
  }
  game <- play_card_garbage(game, player_name, wild_strat)
  # if(!is.null(game$winner)){cat(game$winner, "wins!")}
  game
}

pull_player_card <- function(game, player_name, hand_position){
  stopifnot(class(game) == "garbage_game")
  eval(parse(text = paste0("game$", player_name,"[", hand_position, "]")))
}

replace_player_card <- function(game, player_name, hand_position){
  #sets the active card in place of a particular card in player_name's hand at hand_position, then
  #sets the card that was replaced as the active card.
  stopifnot(class(game) == "garbage_game")
  card_to_replace <- pull_player_card(game, player_name, hand_position)
  eval(parse(text = paste0("game$", player_name,"[", hand_position, "] <- game$active_card")))
  game <- set_card_flipness(game, player_name, hand_position, flipness = TRUE)
  game$active_card <- card_to_replace
  return(did_player_win(game, player_name))
}

did_player_win <- function(game, player_name){
  player_face_ups <- as.character(eval(parse(text = paste0("game$", player_name, "_face_up"))))
  face_downs_idx <- stringr::str_which(player_face_ups, "FALSE")
  if(length(face_downs_idx) == 0){
    game$winner <- player_name
  }
  return(game)
}

discard_garbage <- function(game){
  game$discard <- c(game$active_card, game$discard)
  game$active_card <- NA
  game
}

play_card_garbage <- function(game, player_name, wild_strat = "rand"){
  #deal with wilds
  if(game$active_card %in% game$wilds){
    # cat("wild")
    game <- play_wild_garbage(game, player_name, wild_strat)
    if(is.na(game$active_card)){return(game)}
    return(play_card_garbage(game, player_name, wild_strat))
    }
  #now parse card number
  card_num <- stringr::str_sub(game$active_card, end = -2)
  #deal with Aces, Jacks, Queens, and Kings.
  if (card_num == "A"){card_num <- 1}
  if (card_num %in% c("J", "Q", "K"))
    {return(discard_garbage(game))}
  #now the numbers
  card_num <- as.numeric(card_num)
  #if the card is higher than the hand size, discard it
  hand_size <- length(eval(parse(text = paste0("game$", player_name))))
  if(card_num > hand_size){
    return(discard_garbage(game))}
  #if the player has a facedown card in that spot, replace it and then try to play with the replaced card
  if(!is_card_face_up(game, player_name, card_num)){
    game <- replace_player_card(game, player_name, card_num)
    return(play_card_garbage(game, player_name, wild_strat))
  } else{
    #if the card was face up, see if it's a wild or the same number
    face_up_card <- pull_player_card(game, player_name, card_num)
    if(face_up_card %in% game$wilds){
      #if it's wild, replace and play the wild
      game <- replace_player_card(game, player_name, card_num)
      return(play_card_garbage(game, player_name, wild_strat))
    }
    #check if it's the same number
    face_up_card_num <- stringr::str_sub(face_up_card, end = -2)
    if(face_up_card_num == "A"){
      face_up_card_num <- 1
      }
    if(face_up_card_num == card_num) {
      return(discard_garbage(game))
    }
  }
}

play_wild_garbage <- function(game, player_name, wild_strat = "rand"){
  #uses one of rand, last, first to determine how to play a wild card.
  player_face_ups <- as.character(eval(parse(text = paste0("game$", player_name, "_face_up"))))
  face_downs_idx <- stringr::str_which(player_face_ups, "FALSE")
  if(length(face_downs_idx) < 1){
    return(discard_garbage(game))
  }
  if(wild_strat == "rand"){
    return(replace_player_card(game, player_name, sample(face_downs_idx)[1]))
  }
  if(wild_strat == "last"){
    # cat("\n", game$active_card, "deck is", game$player2, "idxs:", face_downs_idx, "idx:", max(face_downs_idx), "\n",game$player2_face_up)
    return(replace_player_card(game, player_name, max(face_downs_idx)))
  }
  if(wild_strat == "first"){
    return(replace_player_card(game, player_name, min(face_downs_idx)))
  }
}

play_round_garbage <- function(player_names = c("player1", "player2", "Erin"), hand_sizes = c(10,10), 
                                wild_strats = c("rand", "rand", "rand"), random_starting_player = TRUE){
  game <- deal_garbage_hand(create_garbage(players = player_names), hand_sizes = hand_sizes)
  j <- 0
  if(random_starting_player == TRUE){
      player_names <- sample(player_names)
  }
  while (length(game) < 10) {
    for(i in 1:length(player_names)){
      # cat(player_names[i])
      game <- take_turn_garbage(game, player_names[i], wild_strats[i])
      if(length(game) > 9) break
    }
    j <- j+1
    # cat("\n", j, "\n") checkd
  }

  return(game$winner)
}

play_game_garbage <- function(player_names = c("player1", "player2"), wild_strats = c("rand", "rand"), 
                              starting_hand = 10, silent = FALSE, random_starting_player = TRUE) {
  player_hand_sizes <- rep(starting_hand, length(player_names))
  winners <- rep(NA, length(player_names) * starting_hand)
  for(i in 1:length(winners)){
    winners[i] <- play_round_garbage(player_names = player_names, 
                                     hand_sizes = player_hand_sizes, 
                                     wild_strats = wild_strats)
    player_scores <- sapply(player_names, function(x) length(grep(x, winners)))
    if(silent == FALSE){cat("\nleaderboard: ", player_scores)}
    player_hand_sizes <- starting_hand - player_scores
    # cat("\n hand_sizes: ", player_hand_sizes)
    if(min(player_hand_sizes) < 1){break}
  }
  return(paste0(player_names[which.min(player_hand_sizes)], " wins!"))
}

play_x_games_garbage <- function(x, silent = TRUE, ...) {
  games <- rep(NA, x)
  for(i in 1:x){
    games[i] <- play_game_garbage(..., silent = TRUE)
    if(silent == FALSE){cat(games[i])}
  }
  
  return(games)
}

play_x_rounds_garbage <- function(x, ...){
  rounds <- rep(NA, x)
  for(i in 1:x){
    rounds[i] <- play_round_garbage(...)
  }
  rounds
}


