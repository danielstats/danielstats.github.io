  #uses one of rand, last, first to determine how to play a wild card.
  player_face_ups <- as.character(eval(parse(text = paste0("game$", player_name, "_face_up"))))
  face_downs_idx <- stringr::str_which(player_face_ups, "FALSE")
  if(length(face_downs_idx) < 1){
    return(discard_garbage(game))
  }
  if(wild_strat == "rand"){
    return(replace_player_card(game, player_name, sample(face_downs_idx)[1]))
  }
  if(wild_strat == "last"){
    # cat("\n", game$active_card, "deck is", game$player2, "idxs:", face_downs_idx, "idx:", max(face_downs_idx), "\n",game$player2_face_up)
    return(replace_player_card(game, player_name, max(face_downs_idx)))
  }
  if(wild_strat == "first"){
    return(replace_player_card(game, player_name, min(face_downs_idx)))
  }
}

play_round_garbage <- function(player_names = c("player1", "player2", "Erin"), hand_sizes = c(10,10), 
                                wild_strats = c("rand", "rand", "rand"), random_starting_player = TRUE){
  game <- deal_garbage_hand(create_garbage(players = player_names), hand_sizes = hand_sizes)
  j <- 0
  if(random_starting_player == TRUE){
      player_names <- sample(player_names)
  }
  while (length(game) < 10) {
    for(i in 1:length(player_names)){
      # cat(player_names[i])
      game <- take_turn_garbage(game, player_names[i], wild_strats[i])
      if(length(game) > 9) break
    }
    j <- j+1
    # cat("\n", j, "\n") checkd
  }

  return(game$winner)
}

play_game_garbage <- function(player_names = c("player1", "player2"), wild_strats = c("rand", "rand"), 
                              starting_hand = 10, silent = FALSE, random_starting_player = TRUE) {
  player_hand_sizes <- rep(starting_hand, length(player_names))
  winners <- rep(NA, length(player_names) * starting_hand)
  for(i in 1:length(winners)){
    winners[i] <- play_round_garbage(player_names = player_names, 
                                     hand_sizes = player_hand_sizes, 
                                     wild_strats = wild_strats)
    player_scores <- sapply(player_names, function(x) length(grep(x, winners)))
    if(silent == FALSE){cat("\nleaderboard: ", player_scores)}
    player_hand_sizes <- starting_hand - player_scores
    # cat("\n hand_sizes: ", player_hand_sizes)
    if(min(player_hand_sizes) < 1){break}
  }
  return(paste0(player_names[which.min(player_hand_sizes)], " wins!"))
}

