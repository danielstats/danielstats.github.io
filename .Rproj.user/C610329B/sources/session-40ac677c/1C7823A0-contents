#Lesson 9: Strappin Da Bootz

sample_and_stat <- function(dat, n, fun) {
  x <- sample(dat, size = n, replace = TRUE)
  fun(x)
}

bootstrap <- function(data, N, fun, conf = 0.95, return_vars = FALSE){
  n <- length(data)
  obs_var <- fun(data)
  cleveh <- (1 - conf) / 2
  boot_vars <- unlist(map(rep(list(data), N), \(x) sample_and_stat(x, n, fun))) - obs_var
  boot_vars <- obs_var - boot_vars
  if(return_vars) return(boot_vars)
  quantile(boot_vars, c(cleveh, 1 - cleveh))
}




#2 90% conf int for variance of normal with (70.5, 8) 
# Obviously it's 64 (rnorm and all) but what if I don't know that?
set.seed(15)
obs <- rnorm(48, 70.5, 8) |> 
  round(1)
obs_var <- var(obs)
N <- 1000
n <- length(obs)
boot_vars <- rep(NA, N)
for(i in 1:N) {
  x <- sample(obs, size = n, replace = TRUE)
  boot_vars[i] <- var(x)
}
boot_var_diffs <- boot_vars - obs_var
boot_variances <- obs_var - boot_var_diffs 
quantile(boot_variances, c(0.05, 0.95))



