# a Calculate 95% confidence interval for median trip distance
taxi_data <- rio::import("https://emp.byui.edu/johnsonc/data/taxi_trips.xlsx")
X <- taxi_data$trip_distance
obs_stat <- median(X)
N <- 1000
n <- length(X)
boot_stats <- rep(NA, N)
for(i in 1:N) {
  x <- sample(X, size = n, replace = TRUE)
  boot_stats[i] <- median(x)
}
boot_stat_diffs <- boot_stats - obs_stat
boot_statistics <- obs_stat - boot_stat_diffs
quantile(boot_statistics, c(0.025, 0.975))

# b 95% bootstrap confidence interval for slope of regression line total_amount ~ trip_duration

taxil <- lm(total_amount ~ trip_duration, data = taxi_data)

obs_stat <- coef(taxil)[2]
N <- 1000
n <- length(X)
boot_stats <- rep(NA, N)
for(i in 1:N) {
  taxes <- taxi_data[sample(1:n, replace = TRUE),]
  taxil_boot <- lm(total_amount ~ trip_duration, data = taxes)
  boot_stats[i] <- coef(taxil_boot)[2]
}
boot_stat_diffs <- boot_stats - obs_stat
boot_statistics <- obs_stat - boot_stat_diffs 
uplows <- quantile(boot_statistics, c(0.025, 0.975))

b <- coef(taxil)
ggplot(taxi_data, aes(y = total_amount, x = trip_duration)) + 
  geom_point() +
  stat_function(fun = function(x) b[1] + b[2] * x ) +
  stat_function(fun = function(x) b[1] + uplows[1] * x , color = "grey50") +
  stat_function(fun = function(x) b[1] + uplows[2] * x , color = "grey50") +
  labs(title = "Bootstrap Estimates of slope",
       subtitle = "Taxi Data",
       x = "Trip Duration",
       y = "Total Amount (USD)")


