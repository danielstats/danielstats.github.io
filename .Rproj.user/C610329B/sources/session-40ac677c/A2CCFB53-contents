create_players <- function(num_players = 3, names = NULL){
  cat(length(names))
  if(length(names) != num_players) {
    names(players) <- str_c(rep("player", num_players), as.character(1:num_players))
  }
  players <- rep(list(list(points = 0, bet = NULL, in_round = TRUE)), 3)
}

create_luck <- function(players)){
  gamestate <- list(wheel = 1:13,
                 players = players)
  structure(gamestate,
            class = "wheel_game")

}


